# Ollama LLM service URL
OLLAMA_BASE_URL=http://192.168.1.4:11434/api

# Express server port
PORT=3001

# TTS model (speecht5_tts requires speaker_embeddings; mms-tts-eng does not)
# Options: Xenova/speecht5_tts | Xenova/mms-tts-eng
TTS_MODEL=Xenova/speecht5_tts

# Frontend dev: Vite will proxy /ws and /api to this URL
VITE_WS_URL=ws://localhost:3001/ws
