# Ollama LLM service URL
OLLAMA_BASE_URL=http://192.168.1.4:11434/api

# Express server port
PORT=3001

# TTS model — three backends supported:
# Kokoro (JS):    onnx-community/Kokoro-82M-ONNX
# KittenTTS (py): KittenML/kitten-tts-nano-0.8-fp32  ← requires pip install kittentts
# speecht5 (JS):  Xenova/speecht5_tts
# mms (JS):       Xenova/mms-tts-eng
TTS_MODEL=onnx-community/Kokoro-82M-ONNX

# Voice — used by Kokoro and KittenTTS (ignored for speecht5/mms)
# Kokoro voices:    af_heart, af_bella, am_eric, bm_george, ... (see experiments/kokoro.ts)
# KittenTTS voices: Bella, Jasper, Luna, Bruno, Rosie, Hugo, Kiki, Leo
TTS_VOICE=af_heart

# Frontend dev: Vite will proxy /ws and /api to this URL
VITE_WS_URL=ws://localhost:3001/ws
