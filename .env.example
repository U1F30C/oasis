# Ollama LLM service URL
OLLAMA_BASE_URL=http://192.168.1.4:11434/api

# Express server port
PORT=3001

# TTS model — Kokoro and speecht5_tts are fully supported
# Kokoro: onnx-community/Kokoro-82M-ONNX
# speecht5: Xenova/speecht5_tts
# mms: Xenova/mms-tts-eng
TTS_MODEL=onnx-community/Kokoro-82M-ONNX

# Kokoro voice (ignored for non-Kokoro models)
# Run tts.list_voices() in experiments/kokoro.ts to see all options
TTS_VOICE=af_heart

# Frontend dev: Vite will proxy /ws and /api to this URL
VITE_WS_URL=ws://localhost:3001/ws
